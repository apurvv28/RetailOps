# Kafka Cluster Config
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW_EVENTS=retail-events-raw
KAFKA_TOPIC_PREDICTIONS=retail-predictions
KAFKA_CONSUMER_GROUP=retail-ops-consumer-group
KAFKA_AUTO_OFFSET_RESET=latest

# FastAPI Serving Service (Phase 3/4 backend)
PREDICT_API_URL=http://localhost:8080/predict
PREDICT_API_TIMEOUT=10
API_KEY=your_optional_api_key

# Database Connection (CockroachDB / PostgreSQL / SQLite)
DATABASE_URL=sqlite:///../backend/retail_ops.db
# For CockroachDB / Postgres:
# DATABASE_URL=postgresql://user:password@localhost:26257/retail_ops

# Dataset Path
DATASET_PATH=../backend/data/online_retail_II.csv

# Producer Simulation
PRODUCER_DELAY_SECONDS=0.2
PRODUCER_MAX_RETRY_ATTEMPTS=5
PRODUCER_RETRY_BACKOFF_FACTOR=2.0

# Consumer Options
CONSUMER_MAX_RETRY_ATTEMPTS=3

# Logging
LOG_LEVEL=INFO
