# --- COMMON CONFIGS ---
ENVIRONMENT=local # Options: local, production
DATABASE_URL=sqlite:///retail_ops.db # SQLite for local fallback, or postgresql://username:password@host:port/database
API_KEY=krishiloop-secret-key # Used by frontend for X-API-Key header
JWT_SECRET=agritech-jwt-secret-change-in-production

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Use * for local dev only — must be specific domains in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- QUEUE / INGESTION ---
QUEUE_TYPE=local # Options: local (SQLite-based), gcp
# If using GCP Pub/Sub:
GCP_PROJECT_ID=your-gcp-project-id
GCP_PUBSUB_TOPIC=agritech-telemetry-topic
GCP_PUBSUB_SUB=agritech-telemetry-topic-sub
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-credentials.json

# --- GOOGLE OAUTH (for real Google login) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- EXPERIMENT TRACKING ---
MLFLOW_TRACKING_URI=sqlite:///mlruns.db # Or http://localhost:5000
# If using DagsHub / Databricks remote MLflow:
MLFLOW_TRACKING_USERNAME=your_mlflow_username
MLFLOW_TRACKING_PASSWORD=your_mlflow_password

# --- LLM EXPLAINABILITY ---
NVIDIA_API_KEY=your-nvidia-api-key

# --- ALERTS (AWS SES email notifications) ---
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_SES_SENDER_EMAIL=sender@example.com
AWS_SES_RECIPIENT_EMAIL=recipient@example.com
